<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_chat_bubble"
            app:tint="#2196F3"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trợ lý AI RideGo"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#333333"/>
    </LinearLayout>

    <RadioGroup
        android:id="@+id/rgChatMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_input_field"
        android:padding="4dp"
        android:layout_marginBottom="12dp">

        <RadioButton
            android:id="@+id/rbModeCommand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Đặt xe/Lệnh"
            android:button="@null"
            android:gravity="center"
            android:padding="8dp"
            android:checked="true"
            android:background="@drawable/selector_tab_mode"
            android:textColor="@color/selector_text_color"/>

        <RadioButton
            android:id="@+id/rbModeQuery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tra cứu/Hỏi"
            android:button="@null"
            android:gravity="center"
            android:padding="8dp"
            android:background="@drawable/selector_tab_mode"
            android:textColor="@color/selector_text_color"/>
    </RadioGroup>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:nestedScrollingEnabled="false"
        android:layout_marginBottom="12dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/etChatInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Hỏi về chuyến đi của bạn..."
            android:textColor="#000000"
            android:textColorHint="#757575"
            android:textSize="16sp"
            android:padding="12dp"
            android:background="@drawable/bg_input_field"
            android:minHeight="48dp"/>

        <ImageButton
            android:id="@+id/btnSendChat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_circle_app_color"
            android:src="@drawable/ic_send_icon" 
            app:tint="@color/white"/>
            <!-- Lưu ý: Nếu không có ic_send_icon thì dùng tạm ic_back_arrow rotation 180 hoặc tương tự -->

    </LinearLayout>

</LinearLayout>
